# Copy to frontend/.env.local (git-ignored). The publishable key is public by design, but never put a
# service-role/secret key or the JWT signing secret in any frontend variable (VITE_* is exposed to the browser).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_API_BASE_URL=http://localhost:8080/api/v1
