# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
DB_URL=jdbc:postgresql://localhost:5432/cinetogether
DB_USERNAME=cinetogether
DB_PASSWORD=replace-with-local-password

# Supabase project URL (no trailing slash). Same project as the frontend's VITE_SUPABASE_URL.
SUPABASE_URL=https://<project-ref>.supabase.co
